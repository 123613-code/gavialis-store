import 'dotenv/config';
import express from 'express';
import cors from 'cors';
import Database from 'better-sqlite3';
import crypto from 'node:crypto';

const app=express();
const PORT=Number(process.env.PORT||4242);
const CLIENT_URL=process.env.CLIENT_URL||'http://localhost:5173';
const db=new Database('server/store.db');
db.pragma('journal_mode = WAL');
db.exec(`
 CREATE TABLE IF NOT EXISTS orders (id TEXT PRIMARY KEY, created_at TEXT NOT NULL, status TEXT NOT NULL, customer_name TEXT NOT NULL, email TEXT NOT NULL, phone TEXT NOT NULL, address TEXT NOT NULL, city TEXT NOT NULL, state TEXT NOT NULL, pin TEXT NOT NULL, payment_method TEXT NOT NULL, total INTEGER NOT NULL, items_json TEXT NOT NULL, razorpay_order_id TEXT, razorpay_payment_id TEXT);
 CREATE TABLE IF NOT EXISTS subscribers (id INTEGER PRIMARY KEY AUTOINCREMENT,email TEXT UNIQUE NOT NULL,created_at TEXT NOT NULL);
 CREATE TABLE IF NOT EXISTS products (id TEXT PRIMARY KEY,name TEXT NOT NULL,category TEXT NOT NULL,price INTEGER NOT NULL,tag TEXT NOT NULL,colors_json TEXT NOT NULL,description TEXT NOT NULL,image_url TEXT NOT NULL DEFAULT '',sizes_json TEXT NOT NULL,stock INTEGER NOT NULL DEFAULT 0,active INTEGER NOT NULL DEFAULT 1,updated_at TEXT NOT NULL);
`);
// Lightweight migration for databases created by an earlier starter version.
for(const sql of ["ALTER TABLE orders ADD COLUMN razorpay_order_id TEXT","ALTER TABLE orders ADD COLUMN razorpay_payment_id TEXT"]){try{db.exec(sql)}catch{}}
const seed=[
 ['river-hoodie','River Armour Hoodie','hoodies',2799,'BESTSELLER',['#a4d65e','#242820','#c7c1b4'],'Heavyweight 420 GSM cotton-blend fleece. Built for colder nights.', ['XS','S','M','L','XL','XXL'],35],
 ['last-dragon-tee','Last Dragon Tee','tees',1299,'CORE PIECE',['#242820','#a4d65e','#e4e1d8'],'Relaxed oversized fit with a river-dragon graphic.',['XS','S','M','L','XL','XXL'],50],
 ['chambal-cargo','Chambal Utility Cargo','bottoms',2499,'UTILITY',['#343b2d','#1b1d19','#a7a18e'],'Everyday utility pockets and a relaxed straight leg.',['XS','S','M','L','XL','XXL'],25],
 ['river-short','Riverbed Shorts','bottoms',1499,'NEW',['#242820','#7a8467'],'Roomy cut, durable cotton twill and an adjustable waist.',['XS','S','M','L','XL','XXL'],30],
 ['night-shell','Night Current Shell','outerwear',3699,'LIMITED',['#252922','#51594a'],'Lightweight outer layer inspired by riverbank nights.',['XS','S','M','L','XL','XXL'],15],
 ['scale-long-sleeve','Scale Long Sleeve','tees',1799,'NEW',['#a4d65e','#242820'],'A layered long-sleeve silhouette with subtle scale detailing.',['XS','S','M','L','XL','XXL'],20]
];
const productCount=db.prepare('SELECT COUNT(*) n FROM products').get().n;
if(!productCount){const ins=db.prepare('INSERT INTO products(id,name,category,price,tag,colors_json,description,image_url,sizes_json,stock,active,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,1,?)');const tx=db.transaction(()=>seed.forEach(p=>ins.run(p[0],p[1],p[2],p[3],p[4],JSON.stringify(p[5]),p[6],'',JSON.stringify(p[7]),p[8],new Date().toISOString())));tx();}
app.use(cors({origin:CLIENT_URL}));
app.use(express.json({limit:'6mb'}));
const safe=v=>typeof v==='string'?v.trim().slice(0,300):'';
const validPhone=v=>/^[+0-9 ()-]{10,18}$/.test(String(v||'').trim());
const adminAuth=(req,res,next)=>{const configured=process.env.ADMIN_PASSWORD;if(!configured)return res.status(503).json({error:'Set ADMIN_PASSWORD in .env and restart the server.'});const supplied=Buffer.from(String(req.headers['x-admin-password']||'')),expected=Buffer.from(configured);if(supplied.length!==expected.length||!crypto.timingSafeEqual(supplied,expected)){return res.status(401).json({error:'Incorrect admin password.'})}next()};
const productOut=p=>({...p,colors:JSON.parse(p.colors_json),desc:p.description,sizes:JSON.parse(p.sizes_json),image_url:p.image_url||'',stock:Number(p.stock),price:Number(p.price),tag:p.tag||'',category:p.category,active:!!p.active});
app.get('/api/health',(_req,res)=>res.json({ok:true,service:'GAVIALIS Store API',payments:{cod:true,razorpay:!!(process.env.RAZORPAY_KEY_ID&&process.env.RAZORPAY_KEY_SECRET)},admin:!!process.env.ADMIN_PASSWORD}));
app.get('/api/products',(_req,res)=>res.json(db.prepare('SELECT * FROM products WHERE active=1 ORDER BY updated_at DESC').all().map(productOut)));
app.post('/api/admin/login',(req,res)=>{if(!process.env.ADMIN_PASSWORD)return res.status(503).json({error:'Add ADMIN_PASSWORD to .env first.'});if(String(req.body?.password||'')!==process.env.ADMIN_PASSWORD)return res.status(401).json({error:'Wrong password.'});res.json({ok:true})});
app.get('/api/admin/products',adminAuth,(_req,res)=>res.json(db.prepare('SELECT * FROM products ORDER BY updated_at DESC').all().map(productOut)));
app.post('/api/admin/products',adminAuth,(req,res)=>{try{const p=req.body||{};const id=safe(p.id)||safe(p.name).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')+'-'+crypto.randomBytes(2).toString('hex');const name=safe(p.name),category=safe(p.category),price=Number(p.price),stock=Number(p.stock||0),description=safe(p.description),tag=safe(p.tag||'NEW'),colors=Array.isArray(p.colors)?p.colors.filter(x=>typeof x==='string').slice(0,8):['#242820'],sizes=Array.isArray(p.sizes)?p.sizes.filter(x=>['XS','S','M','L','XL','XXL'].includes(x)):['XS','S','M','L','XL','XXL'],image=typeof p.image_url==='string'?p.image_url.slice(0,5000000):'';if(!name||!['hoodies','tees','bottoms','outerwear'].includes(category)||!Number.isInteger(price)||price<1||price>100000||!Number.isInteger(stock)||stock<0||!description||!sizes.length)return res.status(400).json({error:'Check name, category, price, description, sizes and stock.'});if(image&&!/^https?:\/\//i.test(image)&&!/^data:image\/(png|jpeg|jpg|webp);base64,/i.test(image))return res.status(400).json({error:'Image must be a web URL or uploaded PNG/JPG/WEBP.'});db.prepare(`INSERT INTO products(id,name,category,price,tag,colors_json,description,image_url,sizes_json,stock,active,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET name=excluded.name,category=excluded.category,price=excluded.price,tag=excluded.tag,colors_json=excluded.colors_json,description=excluded.description,image_url=excluded.image_url,sizes_json=excluded.sizes_json,stock=excluded.stock,active=excluded.active,updated_at=excluded.updated_at`).run(id,name,category,price,tag,JSON.stringify(colors),description,image,JSON.stringify(sizes),stock,p.active===false?0:1,new Date().toISOString());res.json({ok:true,product:productOut(db.prepare('SELECT * FROM products WHERE id=?').get(id))})}catch(e){console.error(e);res.status(500).json({error:'Could not save product.'})}});
app.delete('/api/admin/products/:id',adminAuth,(req,res)=>{const r=db.prepare('UPDATE products SET active=0,updated_at=? WHERE id=?').run(new Date().toISOString(),req.params.id);if(!r.changes)return res.status(404).json({error:'Product not found.'});res.json({ok:true})});
app.get('/api/admin/orders',adminAuth,(_req,res)=>res.json(db.prepare('SELECT id,created_at,status,customer_name,email,phone,address,city,state,pin,payment_method,total,items_json,razorpay_payment_id FROM orders ORDER BY created_at DESC LIMIT 200').all().map(o=>({...o,items:JSON.parse(o.items_json)}))));
app.patch('/api/admin/orders/:id',adminAuth,(req,res)=>{const status=safe(req.body?.status);if(!['placed','awaiting_payment','paid','processing','shipped','delivered','cancelled'].includes(status))return res.status(400).json({error:'Invalid order status.'});const r=db.prepare('UPDATE orders SET status=? WHERE id=?').run(status,req.params.id);if(!r.changes)return res.status(404).json({error:'Order not found.'});res.json({ok:true})});
app.post('/api/orders',(req,res)=>{try{const c=req.body?.customer||{},items=req.body?.items,method=req.body?.paymentMethod;const name=safe(c.name),email=safe(c.email),phone=safe(c.phone),address=safe(c.address),city=safe(c.city),state=safe(c.state),pin=safe(c.pin);if(!name||!email.includes('@')||!validPhone(phone)||!address||!city||!state||!/^[0-9]{6}$/.test(pin))return res.status(400).json({error:'Please enter valid name, email, phone, complete address and 6-digit PIN code.'});if(!['cod','card','upi'].includes(method))return res.status(400).json({error:'Choose a supported payment method.'});if(!Array.isArray(items)||items.length<1||items.length>40)return res.status(400).json({error:'Your bag is empty or has too many line items.'});const clean=[];for(const item of items){const p=db.prepare('SELECT * FROM products WHERE id=? AND active=1').get(item.id);const quantity=Number(item.quantity);if(!p||!Number.isInteger(quantity)||quantity<1||quantity>20||!JSON.parse(p.sizes_json).includes(item.size))return res.status(400).json({error:'A product, size or quantity is invalid. Refresh your bag and try again.'});if(p.stock<quantity)return res.status(400).json({error:`Not enough stock for ${p.name}.`});clean.push({id:p.id,name:p.name,price:p.price,size:item.size,color:safe(item.color),quantity});}const total=clean.reduce((sum,i)=>sum+i.price*i.quantity,0);const id='GV-'+crypto.randomBytes(4).toString('hex').toUpperCase();db.prepare('INSERT INTO orders (id,created_at,status,customer_name,email,phone,address,city,state,pin,payment_method,total,items_json) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)').run(id,new Date().toISOString(),method==='cod'?'placed':'awaiting_payment',name,email,phone,address,city,state,pin,method,total,JSON.stringify(clean));if(method==='cod'){const dec=db.prepare('UPDATE products SET stock=stock-? WHERE id=?');clean.forEach(i=>dec.run(i.quantity,i.id));}res.status(201).json({orderId:id,status:method==='cod'?'placed':'awaiting_payment',total,message:method==='cod'?'Order placed. Collect payment on delivery.':'Order created; continue to secure payment.'});}catch(err){console.error(err);res.status(500).json({error:'Could not save the order. Please try again.'})}});
app.post('/api/razorpay/create-order',async(req,res)=>{try{if(!process.env.RAZORPAY_KEY_ID||!process.env.RAZORPAY_KEY_SECRET)return res.status(503).json({error:'Razorpay is not configured. Add your Razorpay TEST keys to .env.'});const orderId=safe(req.body?.orderId);const order=db.prepare('SELECT * FROM orders WHERE id=?').get(orderId);if(!order||order.status!=='awaiting_payment')return res.status(404).json({error:'Pending order not found.'});const auth=Buffer.from(`${process.env.RAZORPAY_KEY_ID}:${process.env.RAZORPAY_KEY_SECRET}`).toString('base64');const response=await fetch('https://api.razorpay.com/v1/orders',{method:'POST',headers:{Authorization:`Basic ${auth}`,'Content-Type':'application/json'},body:JSON.stringify({amount:order.total*100,currency:'INR',receipt:order.id,notes:{gavialis_order_id:order.id}})});const data=await response.json();if(!response.ok)throw new Error(data.error?.description||'Razorpay order creation failed');db.prepare('UPDATE orders SET razorpay_order_id=? WHERE id=?').run(data.id,order.id);res.json({keyId:process.env.RAZORPAY_KEY_ID,razorpayOrderId:data.id,amount:data.amount,currency:data.currency});}catch(e){console.error(e);res.status(502).json({error:e.message||'Could not create Razorpay order.'})}});
app.post('/api/razorpay/verify',(req,res)=>{try{const orderId=safe(req.body?.orderId),paymentId=safe(req.body?.razorpay_payment_id),razorpayOrderId=safe(req.body?.razorpay_order_id),signature=safe(req.body?.razorpay_signature);const order=db.prepare('SELECT * FROM orders WHERE id=?').get(orderId);if(!order||!order.razorpay_order_id||order.razorpay_order_id!==razorpayOrderId)return res.status(400).json({error:'Payment order mismatch.'});const expected=crypto.createHmac('sha256',process.env.RAZORPAY_KEY_SECRET||'').update(`${order.razorpay_order_id}|${paymentId}`).digest('hex');const a=Buffer.from(expected),b=Buffer.from(signature);if(a.length!==b.length||!crypto.timingSafeEqual(a,b))return res.status(400).json({error:'Razorpay payment signature is invalid.'});db.prepare("UPDATE orders SET status='paid',razorpay_payment_id=? WHERE id=?").run(paymentId,orderId);const dec=db.prepare('UPDATE products SET stock=stock-? WHERE id=?');JSON.parse(order.items_json).forEach(i=>dec.run(i.quantity,i.id));res.json({ok:true,orderId,status:'paid'});}catch(e){console.error(e);res.status(500).json({error:'Could not verify payment.'})}});
app.post('/api/newsletter',(req,res)=>{const email=safe(req.body?.email).toLowerCase();if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))return res.status(400).json({error:'Enter a valid email.'});try{db.prepare('INSERT INTO subscribers (email,created_at) VALUES (?,?)').run(email,new Date().toISOString());res.status(201).json({ok:true})}catch{res.status(200).json({ok:true,message:'Already subscribed'})}});
app.get('/api/orders/:id',(req,res)=>{const o=db.prepare('SELECT id,created_at,status,payment_method,total,items_json FROM orders WHERE id=?').get(req.params.id);if(!o)return res.status(404).json({error:'Order not found.'});res.json({...o,items:JSON.parse(o.items_json)})});
app.listen(PORT,()=>console.log(`GAVIALIS API running at http://localhost:${PORT}`));
