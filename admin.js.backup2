let adminPassword='';let products=[];const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(path,opts={}){const res=await fetch('/api'+path,{...opts,headers:{'Content-Type':'application/json','x-admin-password':adminPassword,...opts.headers}});const data=await res.json().catch(()=>({}));if(!res.ok)throw new Error(data.error||'Request failed');return data}
async function enterAdmin(){ $('login').hidden=true; $('dashboard').hidden=false; await loadProducts(); }
$('loginForm').addEventListener('submit',async e=>{e.preventDefault();adminPassword=$('password').value;try{await api('/admin/login',{method:'POST',body:JSON.stringify({password:adminPassword})});await enterAdmin();}catch(err){$('loginError').textContent=err.message;adminPassword='';}});

$('logout').onclick=()=>{adminPassword='';$('dashboard').hidden=true;$('login').hidden=false;$('password').value='';};
for(const tab of document.querySelectorAll('.tab'))tab.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===tab));$('productsTab').hidden=tab.dataset.tab!=='products';$('ordersTab').hidden=tab.dataset.tab!=='orders';if(tab.dataset.tab==='orders')loadOrders();};
$('newProduct').onclick=()=>openForm();$('cancelEdit').onclick=()=>{$('productForm').hidden=true;$('productForm').reset();};
function openForm(p=null){$('productForm').hidden=false;$('productForm').reset();$('productId').value=p?.id||'';$('name').value=p?.name||'';$('category').value=p?.category||'hoodies';$('price').value=p?.price||'';$('stock').value=p?.stock??10;$('tag').value=p?.tag||'NEW';$('imageUrl').value=p?.image_url?.startsWith('data:')?'':p?.image_url||'';$('description').value=p?.desc||p?.description||'';$('colors').value=(p?.colors||['#242820','#a4d65e','#c7c1b4']).join(',');$('active').checked=p?.active!==false;document.querySelectorAll('input[name="size"]').forEach(c=>c.checked=(p?.sizes||['XS','S','M','L','XL','XXL']).includes(c.value));$('formMessage').textContent='';$('productForm').scrollIntoView({behavior:'smooth',block:'start'});}
async function loadProducts(){try{products=await api('/admin/products');$('productList').innerHTML=products.map(p=>`<article class="productrow"><div class="thumb">${p.image_url?`<img src="${esc(p.image_url)}" alt="">`:'G.'}</div><div class="productinfo"><b>${esc(p.name)}</b><span>${esc(p.category)} · ₹${Number(p.price).toLocaleString('en-IN')} · stock ${p.stock}</span><small>${esc(p.desc||p.description)}</small></div><span class="status ${p.active?'live':'hiddenstatus'}">${p.active?'LIVE':'HIDDEN'}</span><button class="secondary edit" data-id="${esc(p.id)}">EDIT</button><button class="secondary remove" data-id="${esc(p.id)}">HIDE</button></article>`).join('')||'<p>No products yet.</p>';document.querySelectorAll('.edit').forEach(b=>b.onclick=()=>openForm(products.find(p=>p.id===b.dataset.id)));document.querySelectorAll('.remove').forEach(b=>b.onclick=async()=>{if(!confirm('Hide this product from the shop?'))return;try{await api('/admin/products/'+encodeURIComponent(b.dataset.id),{method:'DELETE'});await loadProducts()}catch(e){alert(e.message)}})}catch(e){$('productList').textContent=e.message}}
$('productForm').addEventListener('submit',async e=>{e.preventDefault();$('formMessage').textContent='Saving…';try{let imageUrl=$('imageUrl').value.trim();const file=$('imageFile').files[0];if(file){if(file.size>3*1024*1024)throw new Error('Please use an image smaller than 3 MB.');imageUrl=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)});}const colors=$('colors').value.split(',').map(x=>x.trim()).filter(x=>/^#[0-9a-f]{6}$/i.test(x));const sizes=[...document.querySelectorAll('input[name="size"]:checked')].map(x=>x.value);const body={id:$('productId').value||undefined,name:$('name').value,category:$('category').value,price:Number($('price').value),stock:Number($('stock').value),tag:$('tag').value,description:$('description').value,image_url:imageUrl,colors:colors.length?colors:['#242820'],sizes,active:$('active').checked};await api('/admin/products',{method:'POST',body:JSON.stringify(body)});$('formMessage').textContent='Saved. Storefront catalogue updated.';$('productForm').hidden=true;await loadProducts()}catch(err){$('formMessage').textContent=err.message}});
async function loadOrders(){try{const orders=await api('/admin/orders');$('orderList').innerHTML=orders.map(o=>`<article class="orderrow"><div><b>${esc(o.id)} · ₹${Number(o.total).toLocaleString('en-IN')}</b><span>${esc(o.customer_name)} · ${esc(o.phone)} · ${esc(o.email)}</span><small>${esc(o.address)}, ${esc(o.city)}, ${esc(o.state)} ${esc(o.pin)}</small><small>${o.items.map(i=>`${esc(i.name)} / ${esc(i.size)} × ${i.quantity}`).join(' · ')}</small><small>Payment: ${esc(o.payment_method)} ${o.razorpay_payment_id?'· '+esc(o.razorpay_payment_id):''}</small></div><div class="ordercontrols"><span class="status">${esc(o.status)}</span><select aria-label="Update order status" data-order="${esc(o.id)}"><option ${o.status==='placed'?'selected':''}>placed</option><option ${o.status==='awaiting_payment'?'selected':''}>awaiting_payment</option><option ${o.status==='paid'?'selected':''}>paid</option><option ${o.status==='processing'?'selected':''}>processing</option><option ${o.status==='shipped'?'selected':''}>shipped</option><option ${o.status==='delivered'?'selected':''}>delivered</option><option ${o.status==='cancelled'?'selected':''}>cancelled</option></select></div></article>`).join('')||'<p>No orders yet.</p>';document.querySelectorAll('[data-order]').forEach(s=>s.onchange=async()=>{try{await api('/admin/orders/'+encodeURIComponent(s.dataset.order),{method:'PATCH',body:JSON.stringify({status:s.value})});await loadOrders()}catch(e){alert(e.message)}})}catch(e){$('orderList').textContent=e.message}}
$('refreshOrders').onclick=loadOrders;
