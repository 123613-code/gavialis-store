PORT=4242
CLIENT_URL=http://localhost:5173
# Make your own long password. Do not use the example text as your real password.
ADMIN_PASSWORD=change-this-to-a-long-private-password
# Razorpay Dashboard > Account & Settings > API Keys. Start with TEST keys.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_with_test_secret
# Set this only if you intentionally use Stripe instead; this build uses Razorpay.
STRIPE_SECRET_KEY=
