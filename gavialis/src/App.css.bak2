@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap');

:root{font-family:'DM Sans',sans-serif;color:#eeeae2;background:#10110f;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;font-optical-sizing:auto;font-weight:400;--bg:#10110f;--panel:#171815;--ink:#eeeae2;--muted:#96968b;--line:#34352f;--acid:#c7f36b;--mono:'DM Mono',monospace;--display:'Barlow Condensed',Impact,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px;background:var(--bg)}button,a{font:inherit}button{color:inherit}a{color:inherit;text-decoration:none}button{cursor:pointer}.site-shell{overflow:hidden}.announcement{height:30px;background:var(--acid);color:#151710;display:flex;align-items:center;justify-content:space-between;padding:0 4.3%;font:9px var(--mono);letter-spacing:.08em}.nav{height:77px;padding:0 4.3%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:var(--bg);position:relative;z-index:5}.wordmark{font:800 31px var(--display);letter-spacing:.025em;line-height:1}.wordmark span{font:10px var(--mono);vertical-align:top;margin-left:3px}.nav-links{display:flex;gap:38px}.nav-links a,.bag-button{font:10px var(--mono);letter-spacing:.1em}.nav-links a{color:#c8c7bd;transition:color .2s}.nav-links a:hover,.back-top:hover{color:var(--acid)}.bag-button{display:flex;align-items:center;gap:11px;background:none;border:0}.bag-count{display:grid;place-items:center;border:1px solid #55564c;width:22px;height:22px;border-radius:50%;font-size:9px}.mobile-menu{display:none}.icon-button{background:none;border:0;padding:8px;display:grid;place-items:center}.hero{height:min(760px,78vw);min-height:600px;position:relative;display:flex;align-items:center;padding:0 8.3%;isolation:isolate;background:#222}.hero-image,.manifesto-image img,.closing-banner>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-image{object-position:center 34%;z-index:-2;filter:grayscale(65%) brightness(.63)}.hero-overlay{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(10,11,9,.93) 0%,rgba(10,11,9,.7) 39%,rgba(10,11,9,.1) 100%),linear-gradient(0deg,rgba(10,11,9,.6),transparent 35%)}.hero-topline,.hero-bottom{position:absolute;left:4.3%;right:4.3%;display:flex;justify-content:space-between;font:9px var(--mono);letter-spacing:.13em;color:#d0d0c7}.hero-topline{top:27px}.hero-bottom{bottom:24px}.hero-copy{max-width:700px;margin-top:15px}.eyebrow{font:10px var(--mono);letter-spacing:.12em;margin:0 0 20px;color:#d1d2c7}.green-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--acid);margin-right:9px}.hero h1,.section-heading h2,.manifesto-copy h2,.values h2,.closing-banner h2{font:800 clamp(76px,11vw,154px)/.79 var(--display);letter-spacing:-.025em;margin:0;text-transform:uppercase}.hero h1 em,.section-heading h2 em,.manifesto-copy h2 em,.values h2 em,.closing-banner h2 em{font-style:normal;color:var(--acid)}.hero-description{font-size:14px;line-height:1.8;color:#c9c8bf;margin:28px 0 25px}.primary-link{display:inline-flex;align-items:center;gap:34px;padding:16px 18px;background:var(--acid);color:#14160f;font:10px var(--mono);letter-spacing:.07em;transition:background .2s,gap .2s}.primary-link:hover{background:#e0ffa0;gap:43px}.hero-stamp{position:absolute;right:8%;bottom:18%;width:84px;height:84px;border:1px solid rgba(238,234,226,.6);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:var(--acid);transform:rotate(10deg)}.hero-stamp span{font:8px/1.3 var(--mono);text-align:center;letter-spacing:.08em}.ticker{overflow:hidden;white-space:nowrap;background:var(--acid);color:#171912;padding:16px 0;font:600 12px var(--mono);letter-spacing:.08em}.ticker div{min-width:max-content;animation:marquee 30s linear infinite}.ticker span{margin:0 28px}@keyframes marquee{to{transform:translateX(-30%)}}.section-pad{padding:100px 8.3%}.collection{background:var(--bg)}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:25px}.muted{color:var(--muted)}.section-heading h2,.values h2{font-size:clamp(56px,7.3vw,98px);line-height:.84}.section-intro{color:#a7a79d;font-size:13px;line-height:1.9;margin:0 0 4px}.filters{display:flex;align-items:center;gap:8px;margin:55px 0 24px;flex-wrap:wrap}.filter{background:transparent;border:1px solid #42433b;color:#b4b4a9;padding:11px 14px;font:9px var(--mono);letter-spacing:.05em;transition:all .2s}.filter:hover,.filter.active{background:var(--acid);border-color:var(--acid);color:#151710}.result-count{margin-left:auto;font:9px var(--mono);color:var(--muted);letter-spacing:.08em}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px 16px}.product-card{min-width:0}.product-image-wrap{position:relative;overflow:hidden;background:#252621;aspect-ratio: .79}.product-image-wrap>img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.7);transition:transform .6s cubic-bezier(.2,.7,.2,1),filter .3s}.product-card:hover .product-image-wrap>img{transform:scale(1.045);filter:saturate(.95)}.product-tag,.product-number{position:absolute;top:13px;font:8px var(--mono);letter-spacing:.08em;background:rgba(15,16,13,.75);padding:8px;color:#eeeae2}.product-tag{left:13px}.product-number{right:13px;color:#c6f36b}.quick-add{position:absolute;bottom:12px;left:12px;right:12px;display:flex;align-items:center;justify-content:space-between;background:var(--acid);color:#151710;border:0;padding:14px;font:9px var(--mono);letter-spacing:.08em;opacity:0;transform:translateY(7px);transition:opacity .2s,transform .2s}.product-card:hover .quick-add,.quick-add:focus-visible{opacity:1;transform:translateY(0)}.product-info{display:flex;justify-content:space-between;gap:12px;padding:15px 1px 0}.product-info h3{font-size:12px;font-weight:600;margin:0 0 7px}.product-info p{font:8px var(--mono);letter-spacing:.035em;color:var(--muted);margin:0}.product-price{font:11px var(--mono);white-space:nowrap}.collection-footer{border-top:1px solid var(--line);margin-top:58px;padding-top:17px;display:flex;justify-content:space-between;gap:15px;font:8px var(--mono);letter-spacing:.08em;color:var(--muted)}.collection-footer span:last-child{display:flex;align-items:center;gap:8px}.manifesto{display:grid;grid-template-columns:1fr 1fr;min-height:600px;background:#1b1d18}.manifesto-image{position:relative;min-height:600px;overflow:hidden}.manifesto-image img{filter:brightness(.67) saturate(.65);object-position:center}.image-caption{position:absolute;bottom:25px;left:30px;font:8px var(--mono);letter-spacing:.1em}.manifesto-copy{position:relative;overflow:hidden;padding:95px 10% 75px 11%;align-self:center}.manifesto-copy h2{font-size:clamp(57px,7vw,92px);line-height:.86;position:relative;z-index:1}.manifesto-copy>p:not(.eyebrow){max-width:390px;color:#b2b3a8;font-size:13px;line-height:1.9;margin:27px 0}.text-link{display:inline-flex;gap:22px;align-items:center;border-bottom:1px solid var(--acid);padding-bottom:10px;font:9px var(--mono);letter-spacing:.08em;color:var(--acid)}.giant-g{position:absolute;bottom:-140px;right:-10px;font:900 380px/.8 var(--display);color:rgba(255,255,255,.025)}.values{display:grid;grid-template-columns:.8fr 1.2fr;gap:8%;background:#e8e6dc;color:#191a16}.values .muted{color:#65665c}.values h2{font-size:clamp(55px,6.8vw,88px)}.values h2 em{color:#657c3c}.value-list{border-top:1px solid #c5c4b9}.value-row{display:grid;grid-template-columns:28px 28px 1fr 20px;align-items:start;gap:15px;border-bottom:1px solid #c5c4b9;padding:24px 0}.value-index{font:9px var(--mono);color:#77786c;padding-top:3px}.value-row>svg{width:20px;height:20px;stroke-width:1.4}.value-row h3{font:600 13px var(--mono);letter-spacing:.04em;margin:0 0 8px}.value-row p{font-size:12px;line-height:1.8;color:#66675d;margin:0;max-width:360px}.value-arrow{color:#718344}.closing-banner{height:530px;position:relative;display:flex;align-items:center;padding:0 8.3%;isolation:isolate}.closing-banner>img{z-index:-2;filter:grayscale(50%) brightness(.55);object-position:center 55%}.closing-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(11,12,9,.8),rgba(11,12,9,.1))}.closing-banner h2{font-size:clamp(82px,12vw,150px);line-height:.78;margin-bottom:30px}.closing-banner .eyebrow{color:#deded2}.closing-mark{position:absolute;right:4.3%;bottom:24px;font:8px var(--mono);letter-spacing:.12em}.footer{display:grid;grid-template-columns:1fr 1fr 1fr auto;align-items:center;gap:20px;padding:37px 4.3% 22px;background:#0b0c0a}.footer .wordmark{font-size:27px}.footer p,.footer>span,.back-top,.footer small{font:8px var(--mono);letter-spacing:.08em;color:#a5a69a}.footer p{margin:0}.back-top{justify-self:end}.footer small{grid-column:1/-1;border-top:1px solid #292a24;padding-top:17px;color:#68695f}.drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:20;display:flex;justify-content:flex-end}.bag-drawer{width:min(480px,100%);height:100%;background:#f0eee6;color:#181914;padding:30px;display:flex;flex-direction:column;animation:drawer-in .25s ease-out}@keyframes drawer-in{from{transform:translateX(30px);opacity:.5}to{transform:translateX(0);opacity:1}}.drawer-header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #cfcec3;padding-bottom:22px}.drawer-header .eyebrow{margin-bottom:7px;color:#77786d}.drawer-header h2{font:700 36px var(--display);margin:0}.drawer-header h2 span{font:12px var(--mono);color:#77786d}.empty-bag{margin:auto;text-align:center;display:flex;align-items:center;flex-direction:column}.empty-bag>svg{margin-bottom:20px}.empty-bag h3{font:700 22px var(--display);margin:0 0 10px}.empty-bag p{font-size:12px;color:#77786d;margin:0 0 24px}.drawer-cta{display:flex;justify-content:space-between;align-items:center;width:100%;padding:16px;background:#c7f36b;border:0;color:#171912;font:10px var(--mono);letter-spacing:.05em}.bag-items{overflow-y:auto;flex:1}.bag-item{display:grid;grid-template-columns:100px 1fr 20px;gap:16px;padding:22px 0;border-bottom:1px solid #cfcec3}.bag-item>img{width:100px;height:125px;object-fit:cover}.bag-item-info h3{font-size:13px;margin:2px 0 7px}.bag-item-info p{font:9px var(--mono);color:#77786d;margin:0 0 11px}.bag-item-info strong{font:12px var(--mono)}.quantity{display:flex;align-items:center;gap:15px;margin-top:13px}.quantity button,.remove-item{background:none;border:0;padding:3px;color:#222}.quantity span{font:11px var(--mono)}.remove-item{align-self:start}.drawer-total{border-top:1px solid #cfcec3;padding-top:20px}.drawer-total>div{display:flex;justify-content:space-between;font:11px var(--mono)}.drawer-total>p{display:flex;align-items:center;gap:7px;color:#66675d;font:9px var(--mono);margin:16px 0}.drawer-total small{display:block;text-align:center;color:#77786d;font-size:10px;margin-top:12px}.drawer-total .drawer-cta{margin-top:17px}
@media(hover:none){.quick-add{opacity:1;transform:none}}
@media(max-width:850px){.section-pad{padding:75px 5.5%}.nav{padding:0 5.5%}.hero{padding:0 6%;min-height:570px;height:76vh}.hero h1{font-size:clamp(80px,14vw,120px)}.hero-stamp{right:6%;bottom:15%;width:72px;height:72px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 13px}.product-info{flex-direction:column;gap:8px}.section-heading h2{font-size:clamp(58px,9vw,80px)}.manifesto{grid-template-columns:1fr 1fr}.manifesto-copy{padding:70px 7%}.manifesto-copy h2{font-size:clamp(55px,8vw,75px)}.values{grid-template-columns:1fr;gap:45px}.footer{grid-template-columns:1fr 1fr}.footer>span{justify-self:end}.back-top{justify-self:start}.hero-stamp{display:none}}
@media(max-width:600px){.announcement{height:27px;padding:0 4%;font-size:7px}.announcement span:nth-child(2){display:none}.nav{height:65px;padding:0 5%}.mobile-menu{display:grid;padding:5px}.mobile-menu svg{width:20px}.wordmark{font-size:28px}.nav-links{display:none;position:absolute;top:65px;left:0;right:0;background:#11120f;border-bottom:1px solid var(--line);padding:23px 6%;flex-direction:column;gap:23px}.nav-links-open{display:flex}.nav-links a{font-size:11px}.bag-button{gap:7px}.bag-button>span:first-child{font-size:9px}.hero{min-height:610px;height:calc(88svh - 92px);max-height:760px;padding:0 6%}.hero-image{object-position:59% center}.hero-overlay{background:linear-gradient(90deg,rgba(10,11,9,.88),rgba(10,11,9,.25)),linear-gradient(0deg,rgba(10,11,9,.6),transparent 55%)}.hero-topline,.hero-bottom{left:6%;right:6%;font-size:7px}.hero-topline span:last-child{max-width:130px;text-align:right}.hero-bottom span:last-child{display:none}.hero h1{font-size:clamp(76px,17vw,110px)}.hero-copy{margin-top:30px}.hero .eyebrow{font-size:8px}.hero-description{font-size:13px}.primary-link{padding:14px;font-size:9px;gap:18px}.section-pad{padding:67px 5%}.section-heading{align-items:flex-start;flex-direction:column;gap:20px}.section-heading h2,.values h2{font-size:clamp(58px,13vw,78px)}.section-intro{font-size:12px}.filters{margin:35px 0 20px;gap:6px}.filter{padding:9px 10px;font-size:8px}.result-count{width:100%;margin:7px 0 0}.product-grid{gap:27px 10px}.product-image-wrap{aspect-ratio:.7}.product-tag,.product-number{top:8px;padding:6px;font-size:7px}.product-tag{left:7px}.product-number{right:7px}.quick-add{left:6px;right:6px;bottom:6px;padding:11px;font-size:8px}.quick-add svg{width:16px}.product-info{padding-top:11px;gap:7px}.product-info h3{font-size:11px;line-height:1.4}.product-info p{font-size:7px;line-height:1.5}.product-price{font-size:10px}.collection-footer{margin-top:38px;flex-direction:column;font-size:7px;line-height:1.6}.manifesto{grid-template-columns:1fr}.manifesto-image{min-height:340px}.manifesto-copy{padding:63px 6% 70px}.manifesto-copy h2{font-size:clamp(66px,14vw,90px)}.manifesto-copy>p:not(.eyebrow){font-size:12px}.values{padding:65px 6%;gap:37px}.value-row{grid-template-columns:20px 23px 1fr 14px;gap:10px;padding:20px 0}.value-row h3{font-size:11px}.value-row p{font-size:11px}.value-row>svg{width:18px}.closing-banner{height:450px;padding:0 6%}.closing-banner h2{font-size:clamp(86px,18vw,125px)}.closing-banner .eyebrow{font-size:9px}.footer{padding:30px 5% 18px;gap:20px 12px}.footer .wordmark{font-size:25px}.footer p,.footer>span,.back-top{font-size:7px;line-height:1.7}.footer>span{text-align:right}.footer small{font-size:7px;line-height:1.6}.bag-drawer{padding:22px}.bag-item{grid-template-columns:83px 1fr 17px;gap:12px}.bag-item>img{width:83px;height:108px}.drawer-header h2{font-size:31px}}

/* Gharial / Chambal art direction layered onto the original storefront */
.hero-image{object-position:center 42%;filter:saturate(.78) contrast(1.08) brightness(.58)}
.hero-overlay{background:linear-gradient(90deg,rgba(7,18,15,.94) 0%,rgba(7,18,15,.65) 43%,rgba(7,18,15,.08) 100%),linear-gradient(0deg,rgba(5,16,13,.7),transparent 42%)}
:root{--acid:#c9ef78;--bg:#0b1512;--panel:#14211b;--line:#34443a}
.ticker{background:#d1ed8b;color:#101a13}
.manifesto{background:#14221b}
.manifesto-image img,.closing-banner>img{filter:saturate(.8) brightness(.65) contrast(1.08)}
.product-image-wrap{background:radial-gradient(ellipse at 50% 30%,#31453a,#171f1a 75%)}
.product-image-wrap>img{object-fit:contain;padding:8px;filter:none}
.product-card:hover .product-image-wrap>img{filter:none}
.hero:after{content:'GAVIALIS GANGETICUS / CHAMBAL BASIN';position:absolute;right:4.3%;top:50%;writing-mode:vertical-rl;transform:translateY(-50%);font:8px var(--mono);letter-spacing:.16em;color:rgba(225,241,205,.75);pointer-events:none}
@media(max-width:600px){.hero:after{display:none}}

/* GAVIALIS 3D FIT LAB — same charcoal / acid-green streetwear theme */
.product-actions{position:absolute;bottom:12px;left:12px;right:12px;display:grid;grid-template-columns:1fr 1fr;gap:7px;z-index:2}
.product-actions .quick-add{position:static;opacity:1;transform:none;min-width:0;padding:13px 10px}
.try-on-button{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:13px 10px;border:1px solid rgba(199,243,107,.8);background:rgba(15,16,13,.88);color:var(--acid);font:9px var(--mono);letter-spacing:.06em;transition:background .2s,color .2s}
.try-on-button:hover{background:var(--acid);color:#151710}
.tryon-backdrop{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.86);display:grid;place-items:center;padding:16px;backdrop-filter:blur(8px)}
.tryon-modal{background:#11120f;color:#eeeae2;width:min(1180px,100%);max-height:94vh;overflow:auto;padding:25px 28px;border:1px solid #383b30;box-shadow:0 30px 100px #000b;animation:drawer-in .22s ease-out}
.tryon-header{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;border-bottom:1px solid #34352f;padding-bottom:17px}
.tryon-header .eyebrow{margin:0 0 7px;color:var(--acid)}
.tryon-header h2{font:800 clamp(34px,4vw,54px)/.9 var(--display);margin:0}
.tryon-header h2 em{font-style:normal;color:var(--acid)}
.tryon-intro{color:#a9ab9e;font-size:12px;line-height:1.7;margin:12px 0 0;max-width:600px}
.true-fit-lab{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.6fr);gap:16px;align-items:stretch;margin-top:17px}
.true-fit-stage{position:relative;min-height:590px;background:radial-gradient(ellipse at 50% 35%,#30372a 0%,#171a14 58%,#0d0e0c 100%);overflow:hidden;border:1px solid #454b39}
.three-mount{position:absolute;inset:0;width:100%;height:100%;min-height:590px;cursor:grab;touch-action:pan-y}.three-mount:active{cursor:grabbing}.three-mount canvas{display:block;width:100%;height:100%}
.fit-stage-label{position:absolute;z-index:2;top:13px;left:14px;right:14px;display:flex;justify-content:space-between;gap:8px;font:8px var(--mono);letter-spacing:.08em;color:#d4dfc2;pointer-events:none}
.avatar-badge{position:absolute;z-index:2;left:14px;bottom:14px;display:grid;gap:4px;padding:10px 12px;background:rgba(16,18,14,.88);border:1px solid #64754a;font:8px var(--mono);letter-spacing:.08em;color:#a9c879;pointer-events:none}.avatar-badge strong{font-size:12px;color:#edf0e7}
.true-fit-controls{display:flex;flex-direction:column;gap:15px;padding:16px;background:#181a15;border:1px solid #34382d;min-width:0}
.face-upload{position:relative;display:flex;align-items:center;justify-content:center;gap:9px;padding:14px;border:1px solid #70834e;color:#d9e6c9;font:9px var(--mono);letter-spacing:.06em;cursor:pointer;overflow:hidden}.face-upload input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}.face-upload:has(input:disabled){opacity:.6;cursor:wait}
.face-status{margin:0;color:#b2b8a6;font-size:11px;line-height:1.65;min-height:44px;overflow-wrap:anywhere}
.true-fit-controls>label:not(.face-upload){display:grid;gap:9px;font:9px var(--mono);letter-spacing:.07em;color:#b7c0aa}.true-fit-controls label strong{justify-self:end;margin-top:-22px;color:#edf0e7}.true-fit-controls input[type=range]{width:100%;accent-color:#a6cf61}.true-fit-controls select{width:100%;padding:10px;border:1px solid #454b39;background:#24271f;color:#eef0e7;font:11px var(--mono)}
.fit-reset{display:flex;justify-content:center;align-items:center;gap:8px;padding:11px;border:1px solid #454b39;background:transparent;color:#d8dfce;font:9px var(--mono);letter-spacing:.07em;cursor:pointer}.fit-note{font-size:10px;line-height:1.6;color:#89927c;margin:0}.true-fit-controls .drawer-cta{margin-top:auto;background:var(--acid);color:#151710;display:flex;justify-content:center;padding:15px;border:0;cursor:pointer;font:10px var(--mono);letter-spacing:.07em}
@media(max-width:760px){.product-actions{left:6px;right:6px;bottom:6px;gap:5px}.product-actions .quick-add,.try-on-button{padding:10px 7px;font-size:7px}.tryon-modal{padding:15px;max-height:96vh}.true-fit-lab{grid-template-columns:1fr}.true-fit-stage{min-height:440px}.three-mount{min-height:440px}.fit-stage-label{font-size:7px}.true-fit-controls{gap:13px}.tryon-header h2{font-size:36px}}

.size-picker{display:grid;grid-template-columns:1fr 1fr;gap:4px}
.size-btn{padding:8px 4px;border:1px solid rgba(199,243,107,.6);background:rgba(15,16,13,.88);color:var(--acid);font:10px var(--mono);letter-spacing:.06em;cursor:pointer;transition:background .2s,color .2s}
.size-btn:hover,.size-btn.active{background:var(--acid);color:#151710}
@media(max-width:760px){.size-btn{padding:6px 2px;font-size:8px}}

.footer-links{display:flex;flex-wrap:wrap;gap:14px;font:10px var(--mono);letter-spacing:.08em}
.footer-links a{color:inherit;text-decoration:none;opacity:.85}
.footer-links a:hover{opacity:1;color:var(--acid)}

.hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;opacity:0;transition:opacity 1.4s ease;filter:saturate(.75) contrast(1.05) brightness(.6)}
.hero-video.on{opacity:1}

/* GAVIALIS redesign */
:root{background:#0b1512}
body{background:transparent;display:block;margin:0;place-items:initial}
#root{max-width:none;width:100%;margin:0;padding:0;text-align:left}
.site-shell{overflow:visible;overflow-x:clip;position:relative;isolation:isolate}
.bg-video{position:fixed;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(ellipse at 30% 20%,#17291f 0%,#0b1512 70%)}
.bg-video-el{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.6s ease}
.bg-video-el.on{opacity:1}
.nav{position:sticky;top:0;z-index:30;background:rgba(9,18,14,.62);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border-bottom:1px solid rgba(201,239,120,.14)}
.hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:56px;align-items:center;height:auto;min-height:0;padding:64px 8.3% 72px;background:transparent}
.hero::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,18,15,.8) 0%,rgba(7,18,15,.4) 60%,rgba(7,18,15,.12) 100%),linear-gradient(0deg,rgba(7,18,15,.55),transparent 30%)}
.hero:after{display:none}
.hero h1{font-size:clamp(60px,8vw,122px);line-height:.82}
.hero-copy{max-width:none;margin:0}
.hero-description{margin:22px 0 28px;color:#d8d8cd;line-height:1.7;font-size:15px}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.ghost-link{display:inline-flex;align-items:center;padding:16px 20px;border:1px solid rgba(238,234,226,.45);font:10px var(--mono);letter-spacing:.07em;transition:background .2s,color .2s,border-color .2s}
.ghost-link:hover{background:var(--acid);color:#14160f;border-color:var(--acid)}
.hero-card{position:relative;margin:0;aspect-ratio:5/4;overflow:hidden;border:1px solid rgba(201,239,120,.35);background:#0b1512;box-shadow:0 30px 80px rgba(0,0,0,.45)}
.hero-card img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 40%;filter:saturate(.85) contrast(1.06) brightness(.8)}
.hero-card figcaption{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-between;gap:10px;padding:38px 16px 14px;background:linear-gradient(0deg,rgba(5,12,9,.88),transparent);font:9px var(--mono);letter-spacing:.1em;color:#dfe9cf}
.hero-card .hero-stamp{position:absolute;top:14px;right:14px;bottom:auto;left:auto;transform:none}
.trust{display:grid;grid-template-columns:repeat(4,1fr);background:rgba(9,18,14,.78);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.trust>*{display:flex;align-items:center;justify-content:center;gap:10px;padding:18px 10px;font:9px var(--mono);letter-spacing:.1em;color:#cfd6c2;border-right:1px solid rgba(201,239,120,.12)}
.trust>*:last-child{border-right:0}
.trust svg{color:var(--acid);flex:none}
.trust a:hover{color:var(--acid)}
.collection{background:rgba(8,16,13,.72);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.collection.section-pad{padding-top:64px;padding-bottom:84px}
.section-heading h2{font-size:clamp(48px,5.6vw,84px)}
.filters{margin:34px 0 24px}
.product-card{transition:transform .3s ease}
.product-card:hover{transform:translateY(-4px)}
@media(max-width:850px){
.hero{grid-template-columns:1fr;gap:34px;padding:44px 6% 56px}
.hero h1{font-size:clamp(56px,16vw,96px)}
.trust{grid-template-columns:repeat(2,1fr)}
.trust>*:nth-child(2){border-right:0}
.trust>*:nth-child(-n+2){border-bottom:1px solid rgba(201,239,120,.12)}
.collection.section-pad{padding:48px 5.5% 64px}
}
@media(max-width:600px){
.trust>*{font-size:8px;padding:14px 6px;letter-spacing:.06em}
.hero-card{aspect-ratio:4/3}
.hero-description{font-size:14px}
.hero-card figcaption{font-size:7px}
}

/* GAVIALIS features */
.announcement{height:34px;font-size:11px}
.wordmark{font-size:34px}
.nav{height:82px}
.nav-links{gap:34px}
.nav-links a,.bag-button{font-size:12px}
.eyebrow{font-size:12px}
.hero h1{font-size:clamp(72px,10vw,156px)}
.hero-description{font-size:18px;line-height:1.65}
.primary-link,.ghost-link{font-size:12px;padding:18px 22px}
.hero-card figcaption{font-size:10px}
.trust>*{font-size:11px}
.section-heading h2{font-size:clamp(56px,7vw,98px)}
.section-intro{font-size:15px;line-height:1.7}
.filter{font-size:11px;padding:12px 16px}
.result-count{font-size:11px}
.product-tag,.product-number{font-size:10px}
.product-info h3{font-size:16px;margin-bottom:8px}
.product-info p{font-size:10px}
.product-price{font-size:15px}
.size-btn{font-size:12px;padding:9px 4px}
.quick-add{font-size:11px}
.manifesto-copy p{font-size:15px;line-height:1.8}
.value-row p{font-size:15px;line-height:1.7}
.footer p,.footer>span,.back-top{font-size:10px}
.footer small{font-size:10px;line-height:1.7}
.footer-links{font-size:11px}
.product-image-wrap>img{cursor:zoom-in}
.pname{cursor:pointer}
.pname:hover{color:var(--acid)}
.wish-btn{position:absolute;top:52px;right:13px;z-index:3;width:34px;height:34px;display:grid;place-items:center;border:1px solid rgba(238,234,226,.35);background:rgba(15,16,13,.75);color:#eeeae2;transition:.2s}
.wish-btn.on,.wish-btn:hover{color:var(--acid);border-color:var(--acid)}
.wish-btn.on svg{fill:var(--acid)}
.qv-chip{position:absolute;top:52px;left:13px;z-index:3;padding:9px 11px;border:1px solid rgba(238,234,226,.35);background:rgba(15,16,13,.75);color:#eeeae2;font:9px var(--mono);letter-spacing:.08em;transition:.2s}
.qv-chip:hover{background:var(--acid);color:#151710;border-color:var(--acid)}
.search-box{display:flex;align-items:center;gap:8px;padding:0 12px;border:1px solid #42433b;color:#b4b4a9;margin-left:auto}
.search-box input{background:transparent;border:0;outline:0;color:#eeeae2;font:12px var(--mono);padding:11px 0;width:150px}
.sort-select{background:rgba(15,16,13,.8);border:1px solid #42433b;color:#d8d8cd;font:11px var(--mono);padding:11px 10px}
.no-results{grid-column:1/-1;font:12px var(--mono);letter-spacing:.08em;color:var(--muted);padding:40px 0;margin:0}
.ship-progress{height:4px;background:rgba(238,234,226,.12);margin:0 0 10px;overflow:hidden}
.ship-progress i{display:block;height:100%;background:var(--acid);transition:width .4s ease}
.qv-backdrop{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.82);display:grid;place-items:center;padding:16px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.qv-modal{position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);width:min(1040px,100%);max-height:94vh;overflow:auto;background:#0f1a15;border:1px solid #34443a;box-shadow:0 30px 100px #000b}
.qv-close{position:absolute;top:8px;right:8px;z-index:4;background:rgba(15,16,13,.7)}
.qv-image{position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 30%,#31453a,#171f1a 75%);min-height:420px;cursor:zoom-in}
.qv-image img{width:100%;height:100%;object-fit:contain;display:block;padding:12px;transition:transform .35s ease}
.qv-image.zoomed{cursor:zoom-out}
.qv-image.zoomed img{transform:scale(2.2)}
.qv-hint{position:absolute;left:12px;bottom:12px;padding:7px 9px;background:rgba(15,16,13,.8);font:9px var(--mono);letter-spacing:.08em;color:#d8d8cd;pointer-events:none}
.qv-info{padding:36px 30px;display:flex;flex-direction:column;gap:14px}
.qv-info h2{font:800 clamp(34px,4vw,52px)/.92 var(--display);margin:0;text-transform:uppercase}
.qv-price{font:600 24px var(--display);margin:0;color:var(--acid);letter-spacing:.04em}
.qv-meta{font:10px var(--mono);letter-spacing:.08em;color:var(--muted);margin:0}
.qv-sizes{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.qv-sizes .size-btn{padding:13px 4px}
.qv-actions{display:grid;gap:10px;margin-top:6px}
.qv-actions .drawer-cta{display:flex;align-items:center;justify-content:center;gap:10px;padding:16px;background:var(--acid);color:#151710;border:0;font:11px var(--mono);letter-spacing:.07em}
.qv-wish{display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;border:1px solid #42433b;background:transparent;font:10px var(--mono);letter-spacing:.07em}
.qv-note{font:10px var(--mono);letter-spacing:.05em;color:var(--muted);margin:0;line-height:1.7}
.js-reveal .reveal{opacity:0;translate:0 26px;transition:opacity .7s ease,translate .7s ease}
.js-reveal .reveal.in{opacity:1;translate:0 0}
@media(prefers-reduced-motion:reduce){.js-reveal .reveal{opacity:1;translate:none;transition:none}.bg-video-el{display:none}}
@media(max-width:850px){.hero h1{font-size:clamp(60px,17vw,104px)}.section-heading h2{font-size:clamp(52px,11vw,84px)}.hero-description{font-size:16px}.qv-modal{grid-template-columns:1fr}.qv-image{min-height:320px}.qv-info{padding:24px 18px}.search-box{margin-left:0;width:100%}.search-box input{width:100%}}
@media(max-width:600px){.announcement{font-size:9px;height:30px}.wordmark{font-size:28px}.nav{height:68px}.nav-links{top:68px}.nav-links a{font-size:13px}.filter{font-size:10px;padding:10px 12px}.product-info h3{font-size:14px}.product-info p{font-size:9px}.product-tag,.product-number{font-size:8px}.wish-btn,.qv-chip{top:44px}.size-btn{font-size:11px;padding:7px 2px}.quick-add{font-size:9px}.trust>*{font-size:9px}.primary-link,.ghost-link{font-size:11px;padding:15px 16px}}

/* GAVIALIS polish */
:root{--muted:#b6b7ab}
.search-box input::placeholder{color:#b9bbae;opacity:1}
.product-info p{color:#b6b7ab}
.bg-video::after{content:'';position:absolute;inset:0;background:rgba(5,11,9,.12)}
.bg-video-el{filter:saturate(.9) brightness(1)}
.product-actions{opacity:0;transform:translateY(8px);transition:opacity .2s,transform .2s}
.product-card:hover .product-actions,.product-actions:focus-within{opacity:1;transform:none}
@media(hover:none){.product-actions{display:none}}
.trust{grid-template-columns:repeat(3,1fr)}
.trust>button{background:none;border:0;cursor:pointer}
.trust>button:hover{color:var(--acid)}
@media(max-width:850px){.trust{grid-template-columns:repeat(3,1fr)}.trust>*:nth-child(2){border-right:1px solid rgba(201,239,120,.12)}.trust>*:nth-child(-n+2){border-bottom:0}}
@media(max-width:600px){.trust>*{font-size:8px;padding:14px 4px;gap:6px;letter-spacing:.04em}.trust svg{width:13px}}
.sg-link{align-self:flex-start;background:none;border:0;border-bottom:1px solid var(--acid);color:var(--acid);font:11px var(--mono);letter-spacing:.08em;padding:0 0 4px}
.sg-backdrop{z-index:70}
.sg-modal{position:relative;width:min(520px,100%);max-height:94vh;overflow:auto;background:#0f1a15;border:1px solid #34443a;padding:34px 28px;box-shadow:0 30px 100px #000b}
.sg-modal h2{font:800 clamp(36px,6vw,52px)/.9 var(--display);margin:0 0 22px}
.sg-table{width:100%;border-collapse:collapse;margin-bottom:18px;font:13px var(--mono)}
.sg-table th{text-align:left;color:var(--muted);font-size:11px;letter-spacing:.08em;padding:10px 8px;border-bottom:1px solid var(--line)}
.sg-table td{padding:13px 8px;border-bottom:1px solid rgba(201,239,120,.12)}
.sg-table td:first-child{color:var(--acid);font-weight:500}
.wa-float{position:fixed;right:18px;bottom:18px;z-index:15;width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:#25d366;color:#0b1512;box-shadow:0 8px 24px rgba(0,0,0,.45);transition:transform .2s}
.wa-float:hover{transform:scale(1.08)}

/* WhatsApp button: exact logo cropped from the reference image */
.wa-float{--wa:60px;position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));width:var(--wa);height:var(--wa);padding:0;border:0;border-radius:0;display:block;z-index:15;background:url('/whatsapp-logo.webp') no-repeat;background-size:calc(var(--wa)*3.772) auto;background-position:calc(var(--wa)*-1.386) calc(var(--wa)*-.4167);box-shadow:none;filter:drop-shadow(0 4px 10px rgba(0,0,0,.5));transition:transform .2s}
.wa-float::after{display:none}
.wa-float:hover{transform:scale(1.1)}
@media(max-width:600px){.wa-float{--wa:54px;right:12px}}

/* let the background video show through */
.nav{background:rgba(11,21,18,.45);backdrop-filter:blur(6px)}
.collection{background:rgba(11,21,18,.25)}
.hero-overlay{background:linear-gradient(90deg,rgba(7,18,15,.55) 0%,rgba(7,18,15,.2) 43%,rgba(7,18,15,0) 100%),linear-gradient(0deg,rgba(5,16,13,.4),transparent 42%)}

/* Footer redesign */
.footer{display:grid;grid-template-columns:1fr auto;align-items:center;gap:18px 32px;padding:48px 6% 24px;background:rgba(8,12,10,.85);backdrop-filter:blur(8px);border-top:1px solid rgba(255,255,255,.1)}
.footer>.wordmark{grid-row:1;grid-column:1;font-size:30px}
.footer>.footer-links{grid-row:1;grid-column:2;justify-self:end;display:flex;flex-wrap:wrap;gap:4px 28px}
.footer>p{grid-row:2;grid-column:1;margin:0}
.footer>span{grid-row:2;grid-column:2;justify-self:end;text-align:right}
.footer>.back-top{grid-row:3;grid-column:2;justify-self:end}
.footer>small{grid-row:4;grid-column:1/-1;margin-top:6px;font-size:10px;color:#8a8b7f}
.footer>p,.footer>span{font:11px/1.7 var(--mono);letter-spacing:.1em;color:#b9baad}
.footer-links a{position:relative;padding:10px 0;font:12px var(--mono);letter-spacing:.14em;color:#e4e5d9;opacity:1;transition:color .2s}
.footer-links a::after{content:'';position:absolute;left:0;bottom:4px;height:1px;width:0;background:var(--acid);transition:width .25s ease}
.footer-links a:hover,.footer-links a:focus-visible{color:var(--acid)}
.footer-links a:hover::after,.footer-links a:focus-visible::after{width:100%}
.footer-links a:focus-visible{outline:2px solid var(--acid);outline-offset:4px}
.footer .back-top{font-size:11px;letter-spacing:.12em;color:#e4e5d9;padding:8px 0}
.footer .back-top:hover{color:var(--acid)}
.footer>.wordmark{order:-2}
.footer>.footer-links{order:-1}
@media(max-width:600px){
  .footer{grid-template-columns:1fr;padding:36px 6% 22px;gap:14px}
  .footer>*{grid-column:1!important;grid-row:auto!important;justify-self:start!important;text-align:left!important}
  .footer-links{gap:2px 22px}
  .footer-links a{padding:12px 0}
}

/* darker nav so it stays readable over light sections */
.nav{background:rgba(11,21,18,.9);backdrop-filter:blur(10px)}

/* Account / login */
.nav-right{display:flex;align-items:center;gap:6px}
.acct-btn{display:flex;align-items:center;gap:8px;background:none;border:0;font:10px var(--mono);letter-spacing:.1em;color:inherit;margin-right:14px}
.acct-btn:hover{color:var(--acid)}
.acct-backdrop{position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.72);display:grid;place-items:center;padding:16px}
.acct-panel{position:relative;width:min(420px,100%);max-height:92vh;overflow-y:auto;background:#11120f;border:1px solid var(--line);padding:28px;color:#e8e6dc}
.acct-close{position:absolute;top:12px;right:12px;background:none;border:0;padding:6px;color:#e8e6dc}
.acct-title{font:800 34px var(--display);text-transform:uppercase;margin:0 0 6px}
.acct-sub{font:10px var(--mono);letter-spacing:.06em;color:#a5a69a;margin:0 0 20px;word-break:break-all}
.acct-tabs{display:flex;gap:8px;margin-bottom:16px}
.acct-tab{flex:1;padding:10px;background:transparent;border:1px solid #42433b;font:9px var(--mono);letter-spacing:.08em;color:#b4b4a9}
.acct-tab.active{background:var(--acid);border-color:var(--acid);color:#151710}
.acct-google{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:14px;background:#fff;color:#1f1f1f;border:0;font:10px var(--mono);letter-spacing:.06em}
.acct-or{text-align:center;font:9px var(--mono);letter-spacing:.08em;color:#77786d;margin:14px 0}
.acct-form{display:flex;flex-direction:column;gap:12px}
.acct-form input{padding:13px;background:#0b0c0a;border:1px solid #42433b;color:#fff;font:12px var(--mono)}
.acct-form input:focus{outline:2px solid var(--acid);outline-offset:1px}
.acct-submit{width:100%;padding:15px;background:var(--acid);border:0;color:#151710;font:10px var(--mono);letter-spacing:.08em}
.acct-submit:disabled{opacity:.6;cursor:wait}
.acct-link{background:none;border:0;color:var(--acid);font:10px var(--mono);text-decoration:underline;padding:0;margin-top:14px}
.acct-msg{font:11px/1.5 var(--mono);padding:10px;margin-top:14px}
.acct-msg.error{background:rgba(255,90,90,.12);color:#ff9d9d}
.acct-msg.ok{background:rgba(199,243,107,.12);color:#c7f36b}
@media(max-width:600px){.acct-btn span{display:none}.acct-btn{margin-right:8px}}

/* Readability + FAQ */
.faq{background:var(--bg);border-top:1px solid var(--line)}
.faq h2{font:800 clamp(52px,7vw,92px)/.86 var(--display);margin:0 0 40px;text-transform:uppercase;letter-spacing:-.02em}
.faq h2 em{font-style:normal;color:var(--acid)}
.faq-list{max-width:860px;border-top:1px solid var(--line)}
.faq-item{border-bottom:1px solid var(--line)}
.faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:20px;background:none;border:0;padding:22px 0;text-align:left;font:600 15px var(--mono);letter-spacing:.03em;color:#eeeae2}
.faq-q svg{flex:none;transition:transform .25s;color:var(--acid)}
.faq-item.open .faq-q svg{transform:rotate(180deg)}
.faq-q:hover{color:var(--acid)}
.faq-a{margin:0 0 24px;max-width:700px;font-size:16px;line-height:1.75;color:#b8b8ad}

@media(max-width:850px){
  body{font-size:16px}
  .hero-description,.section-intro,.manifesto-copy p,.value-row p{font-size:16px;line-height:1.7}
  .filter,.result-count,.nav-links a,.bag-button,.eyebrow,.text-link,.primary-link,.ghost-link{font-size:12px}
  .product-info h3{font-size:15px}
  .product-info p,.product-tag,.product-number,.quick-add,.size-btn,.image-caption,.collection-footer{font-size:11px}
  .product-price{font-size:14px}
  .trust>*{font-size:10px}
  .value-row h3{font-size:14px}
  .footer p,.footer>span,.back-top,.footer small,.footer-links{font-size:11px;line-height:1.7}
  .announcement{font-size:10px}
  .hero-topline,.hero-bottom,.closing-mark{font-size:10px}
  .faq-q{font-size:14px}
  .faq-a{font-size:15px}
}
/* Hero: premium clothing feel */
.hero h1.hero-title{font-size:clamp(46px,6vw,92px);line-height:.9;letter-spacing:-.01em}
.hero-description{max-width:520px;font-size:18px;line-height:1.7;color:#e2e2d8}
.hero .eyebrow{font-size:13px;letter-spacing:.16em}
@media(max-width:850px){
  .hero h1.hero-title{font-size:clamp(44px,13vw,72px)}
  .hero-description{font-size:16px}
  .hero .eyebrow{font-size:12px}
}
/* Mobile product card fix */
@media(max-width:600px){
  .product-number{display:none}
  .product-tag{max-width:calc(100% - 20px);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:9px;padding:5px 7px;letter-spacing:.04em}
  .product-image-wrap{aspect-ratio:.75}
  .qv-chip{font-size:9px;padding:6px 8px;letter-spacing:.04em}
  .product-info h3,.pname{font-size:14px;line-height:1.3}
  .product-info p{font-size:10px;line-height:1.5}
  .product-price{font-size:13px}
  .collection .section-heading h2{font-size:clamp(46px,13vw,64px)}
}
/* Bigger product images on phone */
@media(max-width:600px){
  .product-grid{grid-template-columns:1fr;gap:34px}
  .product-image-wrap{aspect-ratio:.85}
  .product-info h3,.pname{font-size:17px}
  .product-info p{font-size:11px}
  .product-price{font-size:16px}
  .qv-chip,.wish-btn{top:12px}
  .wish-btn{right:12px}
  .qv-chip{left:12px;font-size:10px;padding:8px 10px}
  .product-tag{top:auto;bottom:12px;left:12px}
}
/* Men / Women tabs */
.gender-tabs{display:flex;gap:10px;margin:40px 0 0}
.gender-tab{flex:0 0 auto;background:transparent;border:1px solid #42433b;color:#d8d8cd;padding:14px 28px;font:600 13px var(--mono);letter-spacing:.12em;transition:all .2s}
.gender-tab:hover,.gender-tab.active{background:var(--acid);border-color:var(--acid);color:#151710}
@media(max-width:600px){.gender-tabs{margin-top:28px}.gender-tab{flex:1;padding:14px 0}}
/* ---- breathing room + single-tribute cleanup ---- */
.hero{padding-top:clamp(48px,8vw,96px);padding-bottom:clamp(56px,9vw,110px)}
.hero-card{display:grid;place-items:center;background:radial-gradient(circle at 50% 40%,#16241f,#0b1512)}
.hero-card img{object-fit:contain;padding:clamp(16px,3vw,36px);filter:none}
.section-pad{padding-block:clamp(64px,10vw,120px)}
.manifesto{margin-top:clamp(0px,4vw,48px)}
.closing-banner{height:auto;min-height:0;padding-top:clamp(72px,10vw,120px);padding-bottom:clamp(72px,10vw,120px);background:#0b1512;border-top:1px solid var(--line)}